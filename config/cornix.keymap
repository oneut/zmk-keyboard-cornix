#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

// tap windows for ctl alt
// 変更するときは 1 か所ずつ変え、コミットメッセージに理由 (症状) を残すこと

#define HM_TAPPING_TERM 250
#define HM_PRIOR_IDLE   100  // 2026-10: 70 -> 100 (タイピング中の誤爆対策。文字直後のショートカットが効かなければ下げる)

// shift

#define HM_TAPPING_TERM_SHIFT_L 160  // 2026-10: 190 -> 160 (F を「/」より先に離すと「？」が「ｆ・」になる対策)
#define HM_TAPPING_TERM_SHIFT_R 190
#define HM_PRIOR_IDLE_SHIFT   70

// layer-tap (&lt)

#define LT_TAPPING_TERM 250
#define LT_QUICK_TAP    0    // 2026-10: 175 -> 0 (変換直後に Space 長押し + 右親指で Enter を打つと、quick-tap で Space になっていたため)

// layers

#define BASE 0  // 英字
#define SYM  1  // 数字・記号
#define NAV  2  // カーソル・編集
#define FUNC 3  // ファンクションキー
#define META 4  // Bluetooth

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define KEYS_T LH2 LH1 RH1 RH2  // 実際に使っている親指キー (41 42 | 45 46)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

// 日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        // Positional Homerow mods for shift
        // Ctrl/Alt とは別に tapping-term / prior-idle を調整できるよう定数を分けている。

        hm_shift_l: hm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_SHIFT_L>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE_SHIFT>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_SHIFT_R>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE_SHIFT>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        little_finger_l: little_finger_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            // tap-preferred: 他のキーの押下・解放では GUI に確定せず、tapping-term 経過で GUI になる。
            // ローマ字では "am" のような a → 反対の手 のロールが多く、balanced だと super+m 等が誤発火するため。
            // (prior-idle / quick-tap / hold-trigger-key-positions の条件は引き続き効く。語頭の a は prior-idle では守れない)
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        little_finger_r: little_finger_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            // tap-preferred: 他のキーの押下・解放では GUI に確定せず、tapping-term 経過で GUI になる。
            // ローマ字では "am" のような a → 反対の手 のロールが多く、balanced だと super+m 等が誤発火するため。
            // (prior-idle / quick-tap / hold-trigger-key-positions の条件は引き続き効く。語頭の a は prior-idle では守れない)
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };


        // ZMK 標準の &lt (layer_tap: tap-preferred 200ms) の設定を上書きする。
        // balanced: 押している間に別のキーを押して離すか、tapping-term を超えて押し続けるとレイヤーに入る。
        // Space → 次の文字 のように Space を先に離すロールではレイヤーに入らない。
        // (Space↓ X↓ X↑ Space↑ のように Space を後から離すとレイヤーに入る)
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <LT_TAPPING_TERM>;
            quick-tap-ms = <LT_QUICK_TAP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ----------------------------------------------------------------------------------------
            // |  Q   |  W   |  E   |  R   |  T   |                  |  Y   |  U   |  I   |  O   |  P    |
            // | A    | S    | D    | F    |  G   |                  |  H   | J    | K    | L    | -     |
            // | GUI  | ALT  | CTRL | SHFT |      |                  |      | SHFT | CTRL | ALT  | GUI   |
            // |  Z   |  X   |  C   |  V   |  B   |  MUTE  |  | MB3 |  N   |  M   |  ,   |  .   | /     |
            //                      | 無変換| SPC  |                  | FUNC | 変換 |
            //                      | SYM   | NAV  |                  |      | SYM  |

            bindings = <
&none  &kp Q                    &kp W         &kp E                 &kp R                &kp T                        &kp Y  &kp U                 &kp I               &kp O         &kp P                        &none
&none  &little_finger_l LGUI A  &hm_l LALT S  &hm_l LCTRL D         &hm_shift_l LSHFT F  &kp G                        &kp H  &hm_shift_r RSHIFT J  &hm_r RCTRL K       &hm_r RALT L  &little_finger_r RGUI MINUS  &none
&none  &kp Z                    &kp X         &kp C                 &kp V                &kp B  &kp C_MUTE  &mkp MB3  &kp N  &kp M                 &kp COMMA           &kp DOT       &kp SLASH                    &none
&none  &none                    &none         &lt SYM INT_MUHENKAN  &lt NAV SPACE        &none                        &none  &mo FUNC              &lt SYM INT_HENKAN  &none         &none                        &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        symbol_layer {
            display-name = "Symbol";

            // ※ OS のキーボード配列は日本語 (JIS) 前提
            // ----------------------------------------------------------------------------------------
            // |  !   |  "   |  #   |  $   |  %   |                  |  &   |  '   |  (   |  )   |  |    |
            // | 1    | 2    | 3    | 4    |  5   |                  |  _   | @    | [    | ]    | ~     |
            // | GUI  | ALT  | CTRL | SHFT |      |                  |      | SHFT | CTRL | ALT  | GUI   |
            // |  6   |  7   |  8   |  9   |  0   |        |  |     |  +   |  *   |  {   |  }   |  `    |
            //                      | ^     | ¥    |                  | ;    | :    |
            //                      | SYM   | NAV  |                  | FUNC | SYM  |

            bindings = <
&trans  &kp LS(NUMBER_1)                &kp LS(NUMBER_2)     &kp LS(NUMBER_3)       &kp LS(NUMBER_4)             &kp LS(NUMBER_5)                  &kp LS(NUMBER_6)   &kp LS(NUMBER_7)          &kp LS(NUMBER_8)         &kp LS(NUMBER_9)        &kp JP_PIPE                     &trans
&trans  &little_finger_l LGUI NUMBER_1  &hm_l LALT NUMBER_2  &hm_l LCTRL NUMBER_3   &hm_shift_l LSHIFT NUMBER_4  &kp NUMBER_5                      &kp JP_UNDERSCORE  &hm_shift_r RSHIFT JP_AT  &hm_r RCTRL JP_LBRACKET  &hm_r RALT JP_RBRACKET  &little_finger_r RGUI JP_TILDE  &trans
&none   &kp NUMBER_6                    &kp N7               &kp NUMBER_8           &kp NUMBER_9                 &kp NUMBER_0      &trans  &trans  &kp JP_PLUS        &kp JP_ASTERISK           &kp JP_LBRACE            &kp JP_RBRACE           &kp JP_BACKQUOTE                &trans
&none   &none                           &none                &lt SYM JP_CARET       &lt NAV JP_YEN               &trans                            &trans             &lt FUNC SEMICOLON        &lt SYM JP_COLON         &none                   &none                           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            display-name = "Nav";

            // ----------------------------------------------------------------------------------------
            // |      |      |      |      |      |                  | INS  | PGUP |  ↑   | PGDN |       |
            // | GUI  | ALT  | CTRL | SHFT | TAB  |                  | BSPC |  ←   |  ↓   |  →   |       |
            // | UNDO | CUT  | COPY | PASTE|      |        |  |     | DEL  | HOME |      | END  |       |
            //                      |       |      |                  | ENT  |      |
            //                      |       |      |                  | FUNC |      |

            bindings = <
&none  &none      &none      &none      &none      &none                    &kp INSERT     &kp PAGE_UP     &kp UP    &kp PAGE_DOWN  &none  &none
&none  &kp LGUI   &kp LALT   &kp LCTRL  &kp LSHFT  &kp TAB                  &kp BACKSPACE  &kp LEFT        &kp DOWN  &kp RIGHT      &none  &none
&none  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &none    &trans  &trans  &kp DEL        &kp HOME        &none     &kp END        &none  &none
&none  &none      &none      &trans     &trans     &none                    &none          &lt FUNC ENTER  &none     &none          &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        func_layer {
            display-name = "Func";

            // ----------------------------------------------------------------------------------------
            // |  F1  |  F2  |  F3  |  F4  |      |                  | META |      |      |      |       |
            // |  F5  |  F6  |  F7  |  F8  | TAB  |                  |      | SHFT | CTRL | ALT  | GUI   |
            // |  F9  |  F10 |  F11 |  F12 |      |        |  |     |      |      |      |      |       |
            //                      |       | ESC  |                  |      |      |

            bindings = <
&none  &kp F1  &kp F2   &kp F3   &kp F4      &none                    &mo META  &none       &none      &none     &none     &none
&none  &kp F5  &kp F6   &kp F7   &kp F8      &kp TAB                  &none     &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp F9  &kp F10  &kp F11  &kp F12     &none    &trans  &trans  &none     &none       &none      &none     &none     &none
&none  &none   &none    &none    &kp ESCAPE  &none                    &none     &trans      &trans     &none     &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        meta_layer {
            display-name = "Meta";

            // FUNC (右親指 45) を押したまま Y の位置を押し続けると入る
            // ----------------------------------------------------------------------------------------
            // | BT   | BT   | BT   | BT   |      |                  |      |      |      |      |       |
            // | CLR  | SEL2 | SEL1 | SEL0 |      |                  |      |      |      |      |       |

            bindings = <
&none  &bt BT_CLR      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none                  &none  &none  &none  &none  &none  &none
&none  &none           &none         &none         &none         &none                  &none  &none  &none  &none  &none  &none
&none  &none           &none         &none         &none         &none  &trans  &trans  &none  &none  &none  &none  &none  &none
&none  &none           &none         &none         &none         &none                  &none  &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
